NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://servicedesk:servicedesk@localhost:5432/servicedesk?schema=public
REDIS_URL=redis://localhost:6379

# At least 32 characters. Use a long random value outside local development.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token: valid for 7 days of inactivity, at most 30 days after login
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_AGE_DAYS=30
# A rotated refresh token reused after this many seconds revokes the session
REFRESH_REUSE_GRACE_SECONDS=30

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Background processing
WORKER_CONCURRENCY=4
JOB_STAGE_MIN_MS=2000
JOB_STAGE_MAX_MS=5000
JOB_FAILURE_RATE=0.1

STATS_CACHE_TTL_SECONDS=15
LOG_LEVEL=info
SEED_ON_START=false
